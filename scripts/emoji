#!/usr/bin/bash

# If running in a terminal, use fzf, otherwise use rofi or dmenu
if [ -t 0 ]; then
    FUZZYSELECT=fzf
elif command -v rofi >/dev/null 2>&1; then
    FUZZYSELECT="rofi -dmenu -i -p 'Emoji:'"
else
    FUZZYSELECT="dmenu -l 20 -i -p 'Emoji:'"
fi
emoji=$(cat ~/Documents/emojis_by_category.txt \
    | grep -v -x '[[:blank:]]*' \
    | $FUZZYSELECT)
[ -z "$emoji" ] && exit 0

printf '%s' "$emoji" | xclip -selection clipboard
notify-send -a Emoji -u low -h string:x-dunst-stack-tag:emoji "Copied" "$emoji"
