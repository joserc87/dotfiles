#!/usr/bin/bash

if pass otp -c aws-totp; then
    notify-send -a AWS -h string:x-dunst-stack-tag:aws-totp -t 10000 \
        "AWS SSO TOTP copied" \
        "Your OTP has been copied to the clipboard."
else
    notify-send -a AWS -h string:x-dunst-stack-tag:aws-totp -u critical \
        "AWS SSO TOTP failed" \
        "pass otp -c aws-totp failed: nothing was copied."
fi
