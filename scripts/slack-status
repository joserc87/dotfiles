#!/usr/bin/env bash

DMENU="${DMENU:-dmenu}"

OPTION=$(echo '1. None
2. QQ
3. Lunch
4. Coffee
5. Standup
6. Meeting
7. Pymeeting
8. Pomodoro
' \
    | $DMENU -i -l 10)
[ -z "$OPTION" ] && exit 0

notify() {
    notify-send -a Slack -h string:x-dunst-stack-tag:slack-status "$@"
}

emoji=:python: 
stat=" "
message=""

case $OPTION in
    "1. None")
        emoji=:python: 
        stat=" "
    ;;
    "2. QQ")
        emoji=:donutparrot: 
        stat="QQing"
        message=":qq:"
    ;;
    "3. Lunch")
        emoji=:chompy: 
        stat="Lunching"
    ;;
    "4. Coffee")
        emoji=:teatime: 
        stat="Coffeeing"
    ;;
    "5. Standup")
        emoji=:calendar: 
        stat="In morning standup"
    ;;
    "6. Meeting")
        emoji=:calendar: 
        stat="In A Meeting"
    ;;
    "7. Pymeeting")
        emoji=:calendar: 
        stat="In PyMeeting"
    ;;
    "8. Pomodoro")
        emoji=:tomato: 
        stat="In the zone. Ping if important."
    ;;
esac

echo "I'm $stat... $emoji"
if slack-cli status edit "$stat" "$emoji"; then
    notify -u low "Slack status: ${OPTION#*. }" "$stat $emoji"
else
    notify -u critical "Couldn't set Slack status" "slack-cli status edit failed"
fi
if [[ -n "$message" ]]; then
    slack-cli chat send "$message" "@jcano"
fi
