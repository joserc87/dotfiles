#!/usr/bin/bash

if pass otp -c okta-totp; then
    notify-send -a Okta -h string:x-dunst-stack-tag:okta-totp -t 10000 \
        "Okta TOTP copied" \
        "Your OTP has been copied to the clipboard."
else
    notify-send -a Okta -h string:x-dunst-stack-tag:okta-totp -u critical \
        "Okta TOTP failed" \
        "pass otp -c okta-totp failed: nothing was copied."
fi
