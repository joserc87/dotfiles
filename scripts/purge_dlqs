#!/usr/bin/bash

declare -A PROFILE_MAP=(
    ["smart-topics-dev-nvirginia"]="smart-topics-dev-nvirginia"
    ["smart-topics-stg-nvirginia"]="smart-topics-stg-nvirginia"
    ["smart-topics-prod-nvirginia"]="smart-topics-prod-nvirginia-RW-DO-NOT-USE-THIS-PROFILE"
    ["auth-dev-nvirginia"]="auth-dev-nvirginia"
    ["auth-stg-nvirginia"]="auth-stg-nvirginia"
    ["auth-prod-nvirginia"]="auth-prod-nvirginia-RW-DO-NOT-USE-THIS-PROFILE"
    ["text-analytics-dev"]="text-analytics-dev"
    ["text-analytics-stg"]="text-analytics-stg"
    ["text-analytics-prod"]="text-analytics-prod-RW-DO-NOT-USE-THIS-PROFILE"
)
ENVIRONMENTS=(
    "smart-topics-prod-nvirginia"
    "smart-topics-stg-nvirginia"
    "smart-topics-dev-nvirginia"
    "auth-prod-nvirginia"
    "auth-stg-nvirginia"
    "auth-dev-nvirginia"
    "text-analytics-prod"
    "text-analytics-stg"
    "text-analytics-dev"
)

SELECTED_ENV=$1
if [ -z "$SELECTED_ENV" ] && [ -n "$AWS_PROFILE" ]; then
    # $AWS_PROFILE may already hold the resolved profile name (e.g. set by
    # other tooling) rather than one of our short environment keys, so look
    # it up by value before falling back to using it as a key directly.
    for key in "${!PROFILE_MAP[@]}"; do
        if [ "${PROFILE_MAP[$key]}" == "$AWS_PROFILE" ]; then
            SELECTED_ENV="$key"
            break
        fi
    done
    if [ -z "$SELECTED_ENV" ]; then
        SELECTED_ENV="$AWS_PROFILE"
    fi
fi
if [ -z "$SELECTED_ENV" ]; then
    echo "Select the environment:"
    select env in "${ENVIRONMENTS[@]}"; do
        SELECTED_ENV=$env
        break
    done
fi
if [ -n "${PROFILE_MAP[$SELECTED_ENV]}" ]; then
    export AWS_PROFILE="${PROFILE_MAP[$SELECTED_ENV]}"
fi
echo "Selected environment: $SELECTED_ENV"
echo "Using AWS profile: $AWS_PROFILE"
aws sts get-caller-identity &> /dev/null
if [ $? -ne 0 ]; then
    echo "Not logged in. Logging in to AWS SSO for profile: $AWS_PROFILE"
    aws sso login --profile "$AWS_PROFILE"
fi

function get_all_dlqs() {
    aws sqs list-queues | jq -r '.QueueUrls[]' | grep "dlq"
}

function get_interesting_dlqs() {
    INTERESTING_QUEUES=(
        "auth-notifications-dlq"
        "event-bridge-subscriptions-fanout-dlq"
        "quota-events-processor-dlq"
        "admin-quotas-dlq"
        "subscriptions-event-processor-dlq"
        "subscriptions-org-updater-event-bus-dlq"
        "org-updater-dlq"
        "org-updater-priority-dlq"
        "auth-webhook-notifications-ddb-stream-dlq"
        "auth-notification-consumer-dlq"
        "users-ddb-stream-dlq"
    )
    for queue_url in $(get_all_dlqs); do
        if [[ " ${INTERESTING_QUEUES[@]} " =~ " $(basename "$queue_url") " ]]; then
            echo "$queue_url"
        fi
    done
}

function get_queue_message_count() {
    local queue_url=$1
    aws sqs get-queue-attributes --queue-url "$queue_url" --attribute-names ApproximateNumberOfMessages | jq -r '.Attributes.ApproximateNumberOfMessages'
}

mapfile -t QUEUE_URLS < <(get_interesting_dlqs)

declare -A MESSAGE_COUNTS
while read -r queue_url message_count; do
    MESSAGE_COUNTS["$queue_url"]="$message_count"
done < <(
    for queue_url in "${QUEUE_URLS[@]}"; do
        (echo "$queue_url $(get_queue_message_count "$queue_url")") &
    done
    wait
)

final_message="*DLQs:*\n"
for queue_url in "${QUEUE_URLS[@]}"; do
    queue_name=$(basename "$queue_url")
    echo -ne "Queue $queue_name: "
    message_count="${MESSAGE_COUNTS[$queue_url]}"
    if [ "$message_count" -gt 0 ]; then
        final_message+="* *$queue_name - $message_count*: "
        echo -ne "\e[31m$message_count\e[0m messages. Purge? \e[34m(y/n)\e[0m"
        read -r answer
        if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
            echo -n "..."
            aws sqs purge-queue --queue-url "$queue_url"
            echo "Purged"
            final_message+="Purged :mrclean:\n"
        else
            final_message+="Not purged for now\n"
        fi
    else
        echo -e "\e[32mempty\e[0m"
    fi
done
echo -e "\n\n$final_message\n"
echo -e "$final_message" | setsid -f xclip -selection clipboard >/dev/null 2>&1 <&-
