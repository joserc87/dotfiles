#!/usr/bin/env bash
set -e

TMPFILE=${TMPFILE:-/tmp/vimedit}

xclip -out -selection clipboard > "$TMPFILE"
if test -t 0; then
    nvim $TMPFILE
else
    alacritty -e zsh -c "nvim $TMPFILE"
fi
xclip -in -selection clipboard "$TMPFILE"
notify-send -a Clipboard -u low "Clipboard updated" "$(wc -l < "$TMPFILE") line(s) from the editor"
