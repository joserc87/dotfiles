# dunst >= 1.7 config — gruvbox dark
# Reload with: dunstctl reload

[global]
    ### Placement ###
    monitor = 0
    follow = keyboard
    origin = top-right
    offset = (20, 48)
    width = (320, 480)
    height = (0, 300)
    notification_limit = 5
    gap_size = 8
    indicate_hidden = yes

    ### Look ###
    font = "Noto Sans 13"
    corner_radius = 10
    frame_width = 2
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    separator_height = 2
    separator_color = frame
    transparency = 0
    line_height = 2

    ### Progress bar (volume, brightness, ...) ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4
    highlight = "#83a598"

    ### Text ###
    markup = full
    format = "<span foreground='#bdae93'>%a</span>\n<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    ignore_newline = no
    show_age_threshold = 60
    show_indicators = yes
    stack_duplicates = true
    hide_duplicate_count = false
    sort = yes

    ### Icons ###
    icon_position = left
    icon_theme = "Papirus-Dark, Adwaita"
    enable_recursive_icon_lookup = true
    min_icon_size = 32
    max_icon_size = 48

    ### Behaviour ###
    idle_threshold = 120
    sticky_history = yes
    history_length = 30
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#1d2021"
    foreground = "#ebdbb2"
    frame_color = "#7c6f64"
    highlight = "#689d6a"
    timeout = 5

[urgency_normal]
    background = "#1d2021"
    foreground = "#fbf1c7"
    frame_color = "#83a598"
    timeout = 10

[urgency_critical]
    background = "#2d1312"
    foreground = "#fbf1c7"
    frame_color = "#fb4934"
    highlight = "#fb4934"
    timeout = 0

# Rules — run `dunstctl debug` or `dbus-monitor` to find appname/category values.

# App icons, tracked in ./icons (Papirus + recoloured Simple Icons, CC0).
